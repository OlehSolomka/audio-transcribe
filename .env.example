# Copy to .env and fill in. This must be the same secret as the bot backend's
# TRANSCRIPTION_SHARED_SECRET -- do not generate a new one unless you're
# rotating it in both repos together.
TRANSCRIPTION_SHARED_SECRET=
PORT=4000

# Optional overrides -- defaults already work for local dev (PATH-installed
# binaries via Homebrew) and inside the Docker image (paths baked in at
# build time). Uncomment only if you need something non-standard.
# WHISPER_BINARY=whisper-cli
# WHISPER_MODEL_PATH=./models/ggml-small.bin
# FFMPEG_BINARY=ffmpeg
# TEMP_DIR=./temp
